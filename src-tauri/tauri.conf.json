{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dalizi Files",
  "version": "0.4.0",
  "identifier": "com.dalizi.files",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "呆梨文件 Dalizi Files",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "theme": "dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
